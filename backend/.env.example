# Local development placeholders only. Replace these in the ignored backend/.env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/impullssee
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_TOKEN_MINUTES=720
FRONTEND_URL=http://localhost:5173,http://localhost:5174
RESEND_API_KEY=
CONTACT_EMAIL=
RESEND_FROM_EMAIL=Impullssee Portfolio <onboarding@resend.dev>
ENVIRONMENT=development

# Optional first-admin bootstrap. Configure both variables only when needed.
